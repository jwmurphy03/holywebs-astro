---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/pages/Pricing';

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "name": "Holy Webs Monthly Growth Plans",
  "url": "https://holywebs.com/pricing",
  "itemListElement": [
    {
      "@type": "Offer",
      "name": "Local Growth",
      "price": "3000",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "3000",
        "priceCurrency": "USD",
        "unitText": "month"
      },
      "itemOffered": {
        "@type": "Service",
        "name": "Local Growth Plan",
        "description": "Standard website, Google Ads management, lead tracking, and reporting for local service businesses."
      }
    },
    {
      "@type": "Offer",
      "name": "Local Authority",
      "price": "5000",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "5000",
        "priceCurrency": "USD",
        "unitText": "month"
      },
      "itemOffered": {
        "@type": "Service",
        "name": "Local Authority Plan",
        "description": "Everything in Local Growth plus starter local SEO and Google Business Profile management for local service businesses."
      }
    },
    {
      "@type": "Offer",
      "name": "Market Leader",
      "price": "7500",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "7500",
        "priceCurrency": "USD",
        "unitText": "month"
      },
      "itemOffered": {
        "@type": "Service",
        "name": "Market Leader Plan",
        "description": "Everything in Local Authority plus a premium custom website, regional SEO, Google Maps SEO, and campaign landing pages."
      }
    },
    {
      "@type": "Offer",
      "name": "Enterprise",
      "price": "10000",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "10000",
        "priceCurrency": "USD",
        "unitText": "month",
        "minPrice": "10000"
      },
      "itemOffered": {
        "@type": "Service",
        "name": "Enterprise Plan",
        "description": "Custom local SEO, PPC, custom website strategy, larger content and linking campaigns, weekly check-ins, custom reports, and multi-location growth support."
      }
    }
  ]
};
---
<Layout
  title="Pricing | Holy Webs Monthly Growth Plans"
  description="Transparent monthly pricing for Holy Webs local growth plans. Website, local SEO, Google Business Profile, content, tracking, paid ads management, and enterprise growth options for service businesses."
  canonicalUrl="https://holywebs.com/pricing"
  schema={pricingSchema}
>
  <Pricing client:idle />
</Layout>
